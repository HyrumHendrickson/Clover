@@ -0,0 +1,438 @@
+/**
+ * Turning plots into screen geometry. Everything here is pure and works in
+ * CSS pixels, so it is unit tested without a canvas.
+ *
+ *  - sampleExplicit   y = f(x) or x = f(y), with asymptote and gap detection
+ *  - sampleParam      parametric and polar curves, refined where they bend
+ *  - contourSegments  implicit curves f(x, y) = 0 by marching squares
+ *  - rasterRegion     inequality shading
+ */
+
+const CLAMP = 1e6;
+const clampPx = (v) => (v > CLAMP ? CLAMP : v < -CLAMP ? -CLAMP : v);
+
+/** A jump of more than this many pixels between neighbouring samples is examined. */
+const JUMP = 2;
+
+/**
+ * Sample a function of one variable into polylines.
+ *
+ * Samples one pixel apart. Where neighbouring values jump, the interval is
+ * bisected: a steep but continuous curve (y = 1000x) converges and stays
+ * joined, while an asymptote (tan x, 1/x) or a step (floor x) does not and
+ * becomes a gap. Where the function stops being defined, the edge is located
+ * to sub-pixel accuracy so curves such as sqrt(x) start where they should.
+ *
+ * @param {(u: number) => number} f value at a world coordinate
+ * @param {((x: number, y: number) => boolean) | null} mask restriction, given world x and y
+ * @param {import('./view.js').GraphView} view
+ * @param {{ vertical?: boolean, step?: number }} [options] vertical: x = f(y)
+ * @returns {number[][]} polylines as flat [x0, y0, x1, y1, ...] screen coordinates
+ */
+export function sampleExplicit(f, mask, view, { vertical = false, step = 1 } = {}) {
+  const length = vertical ? view.height : view.width;
+  const worldOf = vertical ? (p) => view.toWorldY(p) : (p) => view.toWorldX(p);
+  const screenOf = vertical ? (v) => view.toScreenX(v) : (v) => view.toScreenY(v);
+
+  const valueAt = (p) => {
+    const u = worldOf(p);
+    const v = f(u);
+    if (!Number.isFinite(v)) return NaN;
+    if (mask && !(vertical ? mask(v, u) : mask(u, v))) return NaN;
+    return clampPx(screenOf(v));
+  };
+
+  const paths = [];
+  let cur = null;
+  const add = (p, s) => {
+    if (vertical) cur.push(s, p);
+    else cur.push(p, s);
+  };
+  const flush = () => {
+    if (cur && cur.length >= 4) paths.push(cur);
+    cur = null;
+  };
+
+  /** Find where the function becomes undefined between a defined and an undefined pixel. */
+  const edge = (definedP, undefinedP) => {
+    let lo = definedP;
+    let hi = undefinedP;
+    for (let i = 0; i < 24; i += 1) {
+      const mid = (lo + hi) / 2;
+      if (Number.isNaN(valueAt(mid))) hi = mid;
+      else lo = mid;
+    }
+    return { p: lo, s: valueAt(lo) };
+  };
+
+  /** Does the curve join up between two samples, or is there a break? */
+  const continuous = (pa, sa, pb, sb) => {
+    let [a, sA, b, sB] = [pa, sa, pb, sb];
+    for (let i = 0; i < 32; i += 1) {
+      const m = (a + b) / 2;
+      const sm = valueAt(m);
+      if (Number.isNaN(sm)) return false;
+      const d1 = Math.abs(sm - sA);
+      const d2 = Math.abs(sB - sm);
+      if (Math.max(d1, d2) < 1) return true;
+      if (d1 >= d2) [b, sB] = [m, sm];
+      else [a, sA] = [m, sm];
+    }
+    return false;
+  };
+
+  let prevP = 0;
+  let prevS = NaN;
+  let prevOk = false;
+  const first = -step;
+  for (let p = first; p <= length + step + 1e-9; p += step) {
+    const s = valueAt(p);
+    const ok = !Number.isNaN(s);
+    if (ok) {
+      if (prevOk) {
+        if (Math.abs(s - prevS) > JUMP && !continuous(prevP, prevS, p, s)) {
+          flush();
+          cur = [];
+        }
+        add(p, s);
+      } else {
+        cur = [];
+        if (p > first) {
+          const e = edge(p, p - step);
+          if (e.p < p) add(e.p, e.s);
+        }
+        add(p, s);
+      }
+    } else if (prevOk) {
+      const e = edge(prevP, p);
+      if (e.p > prevP) add(e.p, e.s);
+      flush();
+    }
+    prevOk = ok;
+    prevP = p;
+    prevS = s;
+  }
+  flush();
+  return paths;
+}
+
+/**
+ * Sample a parametric curve (x(t), y(t)) into polylines.
+ * Segments longer than a few pixels are subdivided where the curve bends, within an evaluation budget.
+ *
+ * @param {(t: number, out: number[]) => void} at writes x and y into `out`
+ * @param {((t: number) => boolean) | null} mask
+ * @param {[number, number]} domain [tmin, tmax]
+ */
+export function sampleParam(at, mask, domain, view, { samples = 1200, budget = 80000 } = {}) {
+  const [t0, t1] = domain;
+  if (!Number.isFinite(t0) || !Number.isFinite(t1) || !(t1 > t0)) return [];
+  const out = [0, 0];
+  const breakDistance = 4 * Math.max(view.width, view.height);
+  let evaluations = 0;
+
+  /** Screen position at t, or false when undefined or restricted away. */
+  const place = (t, store) => {
+    evaluations += 1;
+    if (mask && !mask(t)) return false;
+    at(t, out);
+    if (!Number.isFinite(out[0]) || !Number.isFinite(out[1])) return false;
+    store[0] = clampPx(view.toScreenX(out[0]));
+    store[1] = clampPx(view.toScreenY(out[1]));
+    return true;
+  };
+
+  const paths = [];
+  let cur = null;
+  const flush = () => {
+    if (cur && cur.length >= 4) paths.push(cur);
+    cur = null;
+  };
+
+  const refine = (ta, xa, ya, tb, xb, yb, depth) => {
+    const dist = Math.hypot(xb - xa, yb - ya);
+    if (dist <= 6 || depth >= 12 || evaluations > budget) {
+      if (depth >= 12 && dist > breakDistance) {
+        flush();
+        cur = [xb, yb];
+      } else {
+        cur.push(xb, yb);
+      }
+      return;
+    }
+    const tm = (ta + tb) / 2;
+    const m = [0, 0];
+    if (!place(tm, m)) {
+      flush();
+      cur = [xb, yb];
+      return;
+    }
+    // Distance of the midpoint from the chord decides whether the curve bends here.
+    const deviation = Math.abs((xb - xa) * (ya - m[1]) - (xa - m[0]) * (yb - ya)) / dist;
+    if (dist > 40 || deviation > 0.25) {
+      refine(ta, xa, ya, tm, m[0], m[1], depth + 1);
+      refine(tm, m[0], m[1], tb, xb, yb, depth + 1);
+    } else {
+      cur.push(xb, yb);
+    }
+  };
+
+  let prev = null;
+  let prevT = t0;
+  for (let i = 0; i <= samples; i += 1) {
+    const t = i === samples ? t1 : t0 + ((t1 - t0) * i) / samples;
+    const here = [0, 0];
+    if (place(t, here)) {
+      if (prev) refine(prevT, prev[0], prev[1], t, here[0], here[1], 0);
+      else cur = [here[0], here[1]];
+      prev = here;
+    } else {
+      flush();
+      prev = null;
+    }
+    prevT = t;
+  }
+  flush();
+  return paths;
+}
+
+/** Sample a polar curve r = f(theta). Negative r is drawn on the opposite side, as usual. */
+export function samplePolar(f, mask, domain, view, options) {
+  const at = (theta, out) => {
+    const r = f(theta);
+    if (!Number.isFinite(r) || (mask && !mask(theta, r))) {
+      out[0] = NaN;
+      out[1] = NaN;
+      return;
+    }
+    out[0] = r * Math.cos(theta);
+    out[1] = r * Math.sin(theta);
+  };
+  return sampleParam(at, null, domain, view, { samples: 2400, ...options });
+}
+
+/* ------------------------------------------------------------ marching squares */
+
+// Corner bits: 1 = top-left, 2 = top-right, 4 = bottom-right, 8 = bottom-left.
+// Edges: 0 = top, 1 = right, 2 = bottom, 3 = left.
+const CASES = [
+  [],
+  [[3, 0]],
+  [[0, 1]],
+  [[3, 1]],
+  [[1, 2]],
+  null,
+  [[0, 2]],
+  [[3, 2]],
+  [[3, 2]],
+  [[0, 2]],
+  null,
+  [[1, 2]],
+  [[3, 1]],
+  [[0, 1]],
+  [[3, 0]],
+  [],
+];
+const SADDLE_5 = {
+  positive: [
+    [0, 1],
+    [3, 2],
+  ],
+  negative: [
+    [3, 0],
+    [1, 2],
+  ],
+};
+const SADDLE_10 = {
+  positive: [
+    [3, 0],
+    [1, 2],
+  ],
+  negative: [
+    [0, 1],
+    [3, 2],
+  ],
+};
+
+/**
+ * Trace the curve F(x, y) = 0 as polylines.
+ *
+ * F is evaluated on a grid of `cell` pixels; each cell whose corners differ in
+ * sign gets a segment between linearly interpolated crossings, and segments that
+ * share a crossing are joined into continuous paths (so dashes and joins look
+ * right). A crossing where |F| is larger than at either corner is a pole (as in
+ * 1/x), not a root, and is dropped.
+ *
+ * @param {(x: number, y: number) => number} F
+ * @param {import('./view.js').GraphView} view
+ * @param {{ cell?: number, filter?: ((x: number, y: number) => boolean) | null, maxCells?: number }} [options]
+ *   filter keeps only segments whose midpoint (world coordinates) passes
+ * @returns {number[][]} flat [x0, y0, x1, y1, ...] polylines in screen pixels
+ */
+export function contourPaths(F, view, { cell = 3, filter = null, maxCells = 250000 } = {}) {
+  let c = cell;
+  const { width, height } = view;
+  while ((Math.ceil(width / c) + 2) * (Math.ceil(height / c) + 2) > maxCells) c += 1;
+  const cols = Math.ceil(width / c) + 2;
+  const rows = Math.ceil(height / c) + 2;
+  const xs = new Float64Array(cols);
+  const ys = new Float64Array(rows);
+  for (let i = 0; i < cols; i += 1) xs[i] = view.toWorldX((i - 1) * c);
+  for (let j = 0; j < rows; j += 1) ys[j] = view.toWorldY((j - 1) * c);
+  const vals = new Float64Array(cols * rows);
+  for (let j = 0; j < rows; j += 1) {
+    for (let i = 0; i < cols; i += 1) vals[j * cols + i] = F(xs[i], ys[j]);
+  }
+
+  // Each grid edge has one id, so the two cells sharing an edge agree on its crossing.
+  const index = new Map();
+  const px = [];
+  const py = [];
+  const nextA = [];
+  const nextB = [];
+  const link = (a, b) => {
+    for (const [from, to] of [
+      [a, b],
+      [b, a],
+    ]) {
+      if (nextA[from] === -1) nextA[from] = to;
+      else nextB[from] = to;
+    }
+  };
+
+  const crossing = (edge, i, j) => {
+    let i0 = i;
+    let j0 = j;
+    let i1 = i;
+    let j1 = j;
+    let id;
+    if (edge === 0) {
+      i1 = i + 1;
+      id = (j * cols + i) * 2;
+    } else if (edge === 1) {
+      i0 = i + 1;
+      i1 = i + 1;
+      j1 = j + 1;
+      id = (j * cols + i + 1) * 2 + 1;
+    } else if (edge === 2) {
+      j0 = j + 1;
+      j1 = j + 1;
+      i1 = i + 1;
+      id = ((j + 1) * cols + i) * 2;
+    } else {
+      j1 = j + 1;
+      id = (j * cols + i) * 2 + 1;
+    }
+    const known = index.get(id);
+    if (known !== undefined) return known;
+    const va = vals[j0 * cols + i0];
+    const vb = vals[j1 * cols + i1];
+    const t = va / (va - vb);
+    const x = (i0 - 1) * c + (i1 - i0) * c * t;
+    const y = (j0 - 1) * c + (j1 - j0) * c * t;
+    const fc = F(view.toWorldX(x), view.toWorldY(y));
+    if (!(Math.abs(fc) <= Math.max(Math.abs(va), Math.abs(vb)))) {
+      index.set(id, -2);
+      return -2;
+    }
+    const k = px.length;
+    px.push(x);
+    py.push(y);
+    nextA.push(-1);
+    nextB.push(-1);
+    index.set(id, k);
+    return k;
+  };
+
+  for (let j = 0; j < rows - 1; j += 1) {
+    for (let i = 0; i < cols - 1; i += 1) {
+      const tl = vals[j * cols + i];
+      const tr = vals[j * cols + i + 1];
+      const br = vals[(j + 1) * cols + i + 1];
+      const bl = vals[(j + 1) * cols + i];
+      if (Number.isNaN(tl) || Number.isNaN(tr) || Number.isNaN(br) || Number.isNaN(bl)) continue;
+      const bits = (tl > 0 ? 1 : 0) | (tr > 0 ? 2 : 0) | (br > 0 ? 4 : 0) | (bl > 0 ? 8 : 0);
+      let pairs = CASES[bits];
+      if (pairs === null) {
+        const centre = (tl + tr + br + bl) / 4 > 0 ? 'positive' : 'negative';
+        pairs = (bits === 5 ? SADDLE_5 : SADDLE_10)[centre];
+      }
+      for (const [ea, eb] of pairs) {
+        const a = crossing(ea, i, j);
+        const b = crossing(eb, i, j);
+        if (a < 0 || b < 0) continue;
+        if (filter && !filter(view.toWorldX((px[a] + px[b]) / 2), view.toWorldY((py[a] + py[b]) / 2))) continue;
+        link(a, b);
+      }
+    }
+  }
+
+  const paths = [];
+  const seen = new Uint8Array(px.length);
+  const follow = (start) => {
+    const path = [];
+    let prev = -1;
+    let at = start;
+    while (at !== -1 && !seen[at]) {
+      seen[at] = 1;
+      path.push(px[at], py[at]);
+      const next = nextA[at] !== prev && nextA[at] !== -1 ? nextA[at] : nextB[at];
+      prev = at;
+      at = next !== prev ? next : -1;
+    }
+    return { path, end: at };
+  };
+  // Open curves first, from their ends; what remains is closed loops.
+  for (let k = 0; k < px.length; k += 1) {
+    if (seen[k] || nextB[k] !== -1 || nextA[k] === -1) continue;
+    const { path } = follow(k);
+    if (path.length >= 4) paths.push(path);
+  }
+  for (let k = 0; k < px.length; k += 1) {
+    if (seen[k] || nextA[k] === -1) continue;
+    const { path, end } = follow(k);
+    if (end !== -1) path.push(px[end], py[end]);
+    else path.push(path[0], path[1]);
+    if (path.length >= 4) paths.push(path);
+  }
+  return paths;
+}
+
+/** The same curve as independent [x0, y0, x1, y1, ...] segments. */
+export function contourSegments(F, view, options) {
+  const segs = [];
+  for (const path of contourPaths(F, view, options)) {
+    for (let k = 0; k + 3 < path.length; k += 2) segs.push(path[k], path[k + 1], path[k + 2], path[k + 3]);
+  }
+  return segs;
+}
+
+/* ------------------------------------------------------------------ regions */
+
+/**
+ * Evaluate an inequality region on a grid and return RGBA pixels.
+ * @param {(x: number, y: number) => boolean} region
+ * @param {{ cell?: number, color: [number, number, number], alpha?: number, maxCells?: number }} options
+ */
+export function rasterRegion(region, view, { cell = 2, color, alpha = 0.3, maxCells = 600000 }) {
+  let c = cell;
+  while (Math.ceil(view.width / c) * Math.ceil(view.height / c) > maxCells) c += 1;
+  const cols = Math.ceil(view.width / c);
+  const rows = Math.ceil(view.height / c);
+  const data = new Uint8ClampedArray(cols * rows * 4);
+  const a = Math.round(alpha * 255);
+  let filled = 0;
+  for (let j = 0; j < rows; j += 1) {
+    const y = view.toWorldY((j + 0.5) * c);
+    for (let i = 0; i < cols; i += 1) {
+      if (!region(view.toWorldX((i + 0.5) * c), y)) continue;
+      const k = (j * cols + i) * 4;
+      data[k] = color[0];
+      data[k + 1] = color[1];
+      data[k + 2] = color[2];
+      data[k + 3] = a;
+      filled += 1;
+    }
+  }
+  return { cols, rows, cell: c, data, filled };
+}
diff --git a/js/lib/graph/values.js b/js/lib/graph/values.js
new file mode 100644
index 0000000..8e74c04
--- /dev/null
+++ b/js/lib/graph/values.js
@@ -0,0 +1,400 @@
+/**
+ * Values of the graphing language: numbers, points, and lists of either.
+ *
+ * Arithmetic and functions broadcast over lists the way Desmos does: a scalar
+ * is combined with every element, and two lists must have the same length.
+ */
+
+export const MAX_LIST = 10000;
+
+/** A runtime error with a message that says how to fix the expression. */
+export class GraphEvalError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'GraphEvalError';
+  }
+}
+
+export class Point {
+  constructor(x, y) {
+    this.x = x;
+    this.y = y;
+  }
+}
+
+export const isPoint = (v) => v instanceof Point;
+
+export function kindOf(v) {
+  if (typeof v === 'number') return 'number';
+  if (v instanceof Point) return 'point';
+  if (Array.isArray(v)) return 'list';
+  return 'unknown';
+}
+
+/* ------------------------------------------------------------- scalar math */
+
+const ODD_DENOMINATOR_LIMIT = 99;
+
+/** Smallest denominator d <= 99 with b = n/d, or 0 when b is not a small fraction. */
+function denominatorOf(b) {
+  for (let d = 1; d <= ODD_DENOMINATOR_LIMIT; d += 1) {
+    const scaled = b * d;
+    if (Math.abs(scaled - Math.round(scaled)) < 1e-9 * Math.max(1, Math.abs(scaled))) return d;
+  }
+  return 0;
+}
+
+/**
+ * Power with real results for negative bases and odd-denominator exponents,
+ * so (-8)^(1/3) is -2 and x^(2/3) is defined for negative x.
+ */
+export function realPow(a, b) {
+  if (a < 0 && Number.isFinite(b) && !Number.isInteger(b)) {
+    const d = denominatorOf(b);
+    if (d === 0 || d % 2 === 0) return NaN;
+    const magnitude = Math.pow(-a, b);
+    return Math.round(b * d) % 2 === 0 ? magnitude : -magnitude;
+  }
+  return Math.pow(a, b);
+}
+
+export function nthRoot(n, x) {
+  if (!Number.isFinite(n) || n === 0) return NaN;
+  if (x >= 0) return Math.pow(x, 1 / n);
+  return Number.isInteger(n) && Math.abs(n) % 2 === 1 ? -Math.pow(-x, 1 / n) : NaN;
+}
+
+const LANCZOS = [
+  0.99999999999980993, 676.5203681218851, -1259.1392167224028, 771.32342877765313, -176.61502916214059,
+  12.507343278686905, -0.13857109526572012, 9.9843695780195716e-6, 1.5056327351493116e-7,
+];
+
+export function gamma(z) {
+  if (z < 0.5) return Math.PI / (Math.sin(Math.PI * z) * gamma(1 - z));
+  const w = z - 1;
+  let sum = LANCZOS[0];
+  for (let i = 1; i < LANCZOS.length; i += 1) sum += LANCZOS[i] / (w + i);
+  const t = w + 7.5;
+  return Math.sqrt(2 * Math.PI) * Math.pow(t, w + 0.5) * Math.exp(-t) * sum;
+}
+
+export function factorial(n) {
+  if (!Number.isFinite(n)) return NaN;
+  if (Number.isInteger(n)) {
+    if (n < 0) return NaN;
+    if (n > 170) return Infinity;
+    let result = 1;
+    for (let i = 2; i <= n; i += 1) result *= i;
+    return result;
+  }
+  return gamma(n + 1);
+}
+
+export function gcd(a, b) {
+  if (!Number.isInteger(a) || !Number.isInteger(b)) return NaN;
+  let x = Math.abs(a);
+  let y = Math.abs(b);
+  while (y) [x, y] = [y, x % y];
+  return x;
+}
+
+export function lcm(a, b) {
+  if (!Number.isInteger(a) || !Number.isInteger(b)) return NaN;
+  if (a === 0 || b === 0) return 0;
+  return Math.abs(a * b) / gcd(a, b);
+}
+
+export function nCr(n, k) {
+  if (!Number.isInteger(n) || !Number.isInteger(k) || n < 0 || k < 0 || k > n) return NaN;
+  const m = Math.min(k, n - k);
+  let result = 1;
+  for (let i = 1; i <= m; i += 1) result = (result * (n - m + i)) / i;
+  return Math.round(result);
+}
+
+export function nPr(n, k) {
+  if (!Number.isInteger(n) || !Number.isInteger(k) || n < 0 || k < 0 || k > n) return NaN;
+  let result = 1;
+  for (let i = 0; i < k; i += 1) result *= n - i;
+  return result;
+}
+
+export function roundTo(x, digits) {
+  if (digits === undefined) return Math.round(x);
+  if (!Number.isInteger(digits) || digits < 0 || digits > 15) return NaN;
+  const scale = 10 ** digits;
+  return Math.round(x * scale) / scale;
+}
+
+/** sin and cos of an angle in degrees, exact at multiples of 90. */
+export function sinDeg(d) {
+  const r = ((d % 360) + 360) % 360;
+  if (r === 0 || r === 180) return 0;
+  if (r === 90) return 1;
+  if (r === 270) return -1;
+  return Math.sin((r * Math.PI) / 180);
+}
+
+export function cosDeg(d) {
+  const r = ((d % 360) + 360) % 360;
+  if (r === 90 || r === 270) return 0;
+  if (r === 0) return 1;
+  if (r === 180) return -1;
+  return Math.cos((r * Math.PI) / 180);
+}
+
+export function tanDeg(d) {
+  const r = ((d % 180) + 180) % 180;
+  if (r === 0) return 0;
+  if (r === 90) return NaN;
+  return Math.tan((r * Math.PI) / 180);
+}
+
+/* ---------------------------------------------------------------- broadcast */
+
+function scalarOp(op, a, b) {
+  switch (op) {
+    case '+':
+      return a + b;
+    case '-':
+      return a - b;
+    case '*':
+      return a * b;
+    case '/':
+      return a / b;
+    default:
+      return realPow(a, b);
+  }
+}
+
+function pointOp(op, a, b) {
+  const pa = a instanceof Point;
+  const pb = b instanceof Point;
+  if (pa && pb) {
+    if (op === '+') return new Point(a.x + b.x, a.y + b.y);
+    if (op === '-') return new Point(a.x - b.x, a.y - b.y);
+    throw new GraphEvalError(
+      `Two points cannot be combined with "${op}". Add or subtract them, or multiply one by a number.`,
+    );
+  }
+  if (pa && typeof b === 'number') {
+    if (op === '*') return new Point(a.x * b, a.y * b);
+    if (op === '/') return new Point(a.x / b, a.y / b);
+  }
+  if (pb && typeof a === 'number' && op === '*') return new Point(a * b.x, a * b.y);
+  throw new GraphEvalError(
+    `A point cannot be used with "${op}" here. Multiply or divide a point by a number, or add two points.`,
+  );
+}
+
+/** Apply a binary operator to numbers, points, and lists. */
+export function arith(op, a, b) {
+  if (typeof a === 'number' && typeof b === 'number') return scalarOp(op, a, b);
+  const la = Array.isArray(a);
+  const lb = Array.isArray(b);
+  if (la && lb) {
+    if (a.length !== b.length) {
+      throw new GraphEvalError(`Lists must have the same length to be combined (${a.length} and ${b.length}).`);
+    }
+    return a.map((v, i) => arith(op, v, b[i]));
+  }
+  if (la) return a.map((v) => arith(op, v, b));
+  if (lb) return b.map((v) => arith(op, a, v));
+  return pointOp(op, a, b);
+}
+
+export function negate(v) {
+  if (typeof v === 'number') return -v;
+  if (v instanceof Point) return new Point(-v.x, -v.y);
+  if (Array.isArray(v)) return v.map(negate);
+  throw new GraphEvalError('Only numbers, points, and lists can be negated.');
+}
+
+/** Apply a one-number function to a number or every element of a list. */
+export function mapNumbers(name, fn, v) {
+  if (typeof v === 'number') return fn(v);
+  if (Array.isArray(v)) return v.map((item) => mapNumbers(name, fn, item));
+  throw new GraphEvalError(`${name}() needs numbers, not a ${kindOf(v)}.`);
+}
+
+/** Apply a two-number function with list broadcasting. */
+export function mapNumbers2(name, fn, a, b) {
+  if (typeof a === 'number' && typeof b === 'number') return fn(a, b);
+  const la = Array.isArray(a);
+  const lb = Array.isArray(b);
+  if (la && lb) {
+    if (a.length !== b.length) {
+      throw new GraphEvalError(`${name}() needs lists of the same length (${a.length} and ${b.length}).`);
+    }
+    return a.map((v, i) => mapNumbers2(name, fn, v, b[i]));
+  }
+  if (la) return a.map((v) => mapNumbers2(name, fn, v, b));
+  if (lb) return b.map((v) => mapNumbers2(name, fn, a, v));
+  throw new GraphEvalError(`${name}() needs numbers, not a ${kindOf(a)} and a ${kindOf(b)}.`);
+}
+
+/** Call fn once per element when any argument is a list; scalars are repeated. */
+export function broadcastCall(name, fn, args) {
+  let length = -1;
+  for (const v of args) {
+    if (!Array.isArray(v)) continue;
+    if (length >= 0 && v.length !== length) {
+      throw new GraphEvalError(`${name}() needs lists of the same length.`);
+    }
+    length = v.length;
+  }
+  if (length < 0) return fn(args);
+  const out = new Array(length);
+  for (let i = 0; i < length; i += 1) out[i] = fn(args.map((v) => (Array.isArray(v) ? v[i] : v)));
+  return out;
+}
+
+/* -------------------------------------------------------------------- lists */
+
+/** Build [start, second ... end]. With no end, `limit` bounds the count. */
+export function makeRange(start, second, end) {
+  if (typeof start !== 'number' || typeof end !== 'number' || (second !== null && typeof second !== 'number')) {
+    throw new GraphEvalError('A list range such as [1...10] needs numbers.');
+  }
+  if (!Number.isFinite(start) || !Number.isFinite(end)) return [];
+  const step = second === null ? (end >= start ? 1 : -1) : second - start;
+  if (step === 0 || (end - start) * step < 0) return second === null || start === end ? [start] : [];
+  const count = Math.floor((end - start) / step + 1e-9) + 1;
+  if (count > MAX_LIST) throw new GraphEvalError(`Lists can have at most ${MAX_LIST} items.`);
+  const out = new Array(count);
+  for (let i = 0; i < count; i += 1) out[i] = start + step * i;
+  return out;
+}
+
+/** Flatten list items, ranges, and scalars into one list. */
+export function flattenItems(values) {
+  const out = [];
+  for (const v of values) {
+    if (Array.isArray(v)) out.push(...v);
+    else out.push(v);
+    if (out.length > MAX_LIST) throw new GraphEvalError(`Lists can have at most ${MAX_LIST} items.`);
+  }
+  return out;
+}
+
+/** L[k] for one index, or a sub-list for several. Indices start at 1. */
+export function indexList(list, index) {
+  if (!Array.isArray(list)) throw new GraphEvalError('Only lists can be indexed with [ ].');
+  const pick = (k) => {
+    if (typeof k !== 'number' || !Number.isInteger(k) || k < 1 || k > list.length) return NaN;
+    return list[k - 1];
+  };
+  if (typeof index === 'number') return pick(index);
+  if (Array.isArray(index)) return index.map(pick);
+  throw new GraphEvalError('A list index must be a number or a list of numbers.');
+}
+
+function numbersOnly(name, list) {
+  if (!Array.isArray(list)) throw new GraphEvalError(`${name}() needs a list.`);
+  for (const v of list) {
+    if (typeof v !== 'number') throw new GraphEvalError(`${name}() needs a list of numbers.`);
+  }
+  return list;
+}
+
+export function total(list) {
+  if (!Array.isArray(list)) throw new GraphEvalError('total() needs a list.');
+  if (list.length === 0) return 0;
+  let acc = list[0];
+  for (let i = 1; i < list.length; i += 1) acc = arith('+', acc, list[i]);
+  return acc;
+}
+
+export const listLength = (list) => {
+  if (!Array.isArray(list)) throw new GraphEvalError('length() needs a list.');
+  return list.length;
+};
+
+export function mean(list) {
+  const nums = numbersOnly('mean', list);
+  return nums.length === 0 ? NaN : nums.reduce((a, b) => a + b, 0) / nums.length;
+}
+
+export function median(list) {
+  const nums = [...numbersOnly('median', list)].sort((a, b) => a - b);
+  if (nums.length === 0) return NaN;
+  const mid = nums.length >> 1;
+  return nums.length % 2 ? nums[mid] : (nums[mid - 1] + nums[mid]) / 2;
+}
+
+function sumSquares(nums) {
+  const m = nums.reduce((a, b) => a + b, 0) / nums.length;
+  return nums.reduce((acc, v) => acc + (v - m) * (v - m), 0);
+}
+
+/** Sample standard deviation (divides by n - 1). */
+export function stdev(list) {
+  const nums = numbersOnly('stdev', list);
+  return nums.length < 2 ? NaN : Math.sqrt(sumSquares(nums) / (nums.length - 1));
+}
+
+/** Population standard deviation (divides by n). */
+export function stdevp(list) {
+  const nums = numbersOnly('stdevp', list);
+  return nums.length === 0 ? NaN : Math.sqrt(sumSquares(nums) / nums.length);
+}
+
+export function listMin(list) {
+  const nums = numbersOnly('min', list);
+  return nums.length === 0 ? NaN : Math.min(...nums);
+}
+
+export function listMax(list) {
+  const nums = numbersOnly('max', list);
+  return nums.length === 0 ? NaN : Math.max(...nums);
+}
+
+export function sortList(list) {
+  return [...numbersOnly('sort', list)].sort((a, b) => a - b);
+}
+
+export function uniqueList(list) {
+  if (!Array.isArray(list)) throw new GraphEvalError('unique() needs a list.');
+  const seen = new Set();
+  const out = [];
+  for (const v of list) {
+    const key = v instanceof Point ? `${v.x},${v.y}` : v;
+    if (seen.has(key)) continue;
+    seen.add(key);
+    out.push(v);
+  }
+  return out;
+}
+
+export function joinLists(lists) {
+  return flattenItems(lists);
+}
+
+/* --------------------------------------------------------------- formatting */
+
+/** Format a number with up to `digits` significant digits and no trailing zeros. */
+export function formatNumber(n, digits = 10) {
+  if (Number.isNaN(n)) return 'undefined';
+  if (!Number.isFinite(n)) return n > 0 ? '\u221e' : '-\u221e';
+  if (n === 0) return '0';
+  const abs = Math.abs(n);
+  if (abs >= 1e12 || abs < 1e-6) {
+    return n
+      .toExponential(digits - 1)
+      .replace(/\.?0+e/, 'e')
+      .replace('e+', 'e');
+  }
+  return String(Number(n.toPrecision(digits)));
+}
+
+/** Format any value for display, shortening long lists. */
+export function formatValue(v, maxItems = 8) {
+  if (typeof v === 'number') return formatNumber(v);
+  if (v instanceof Point) return `(${formatNumber(v.x)}, ${formatNumber(v.y)})`;
+  if (Array.isArray(v)) {
+    const shown = v.slice(0, maxItems).map((item) => formatValue(item, maxItems));
+    const more = v.length > maxItems ? `, \u2026 (${v.length} items)` : '';
+    return `[${shown.join(', ')}${more}]`;
+  }
+  return 'undefined';
+}
